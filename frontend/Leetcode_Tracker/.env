# Committed on purpose. Vite inlines every VITE_* var into the JavaScript bundle it
# ships to the browser, so nothing here can be secret by construction. Real secrets
# live in backend/.env (gitignored) or Cloud Run's environment.

# Base URL of the FastAPI backend, including the /api prefix every endpoint sits
# under. Local dev only: the Vite dev server and the API are separate origins here.
# The production build overrides this with a bare "/api" (see the Dockerfile), so
# the deployed app calls its own origin and no CORS is involved.
VITE_API_URL=http://localhost:8000/api

# Identifies the app to Google from inside the browser. Must match GOOGLE_CLIENT_ID
# in backend/.env: the frontend asks Google for a token stamped with this id, and
# the backend only accepts tokens stamped with it.
VITE_GOOGLE_CLIENT_ID=32386885481-ngu21nl01ceeosaiur060vpf7nbaoafd.apps.googleusercontent.com
