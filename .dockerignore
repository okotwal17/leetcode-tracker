# The local virtualenv holds macOS binaries — copying it over the image's own
# would break the interpreter in ways that only show up at runtime.
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache

# Rebuilt inside the image; copying the host's would defeat the layer cache and
# could ship a stale bundle.
**/node_modules
**/dist

# Secrets are injected by Cloud Run at runtime, never baked into a layer.
**/.env
**/.env.*

# ...except the frontend's, which the Vite build needs. Safe to ship: Vite only
# exposes VITE_* vars and inlines them into the browser bundle, so every value in
# that file is public by construction. backend/.env stays excluded above.
!frontend/Leetcode_Tracker/.env

.git
.gitignore
.vscode
**/.DS_Store
backend/tests
